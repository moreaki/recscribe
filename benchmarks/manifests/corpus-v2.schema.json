{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moreaki/recscribe/benchmarks/manifests/corpus-v2.schema.json",
  "title": "RecScribe corpus preparation and frozen evidence v2",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_version",
    "frozen",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1
    },
    "frozen": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "variety",
          "domain",
          "session_id",
          "source_id",
          "audio",
          "reference",
          "license",
          "source_url",
          "reference_conventions",
          "sha256",
          "reference_sha256",
          "id",
          "category",
          "language",
          "script",
          "task",
          "split",
          "duration_seconds",
          "conditions",
          "speaker_ids",
          "source_channel",
          "code_switches",
          "reviewed",
          "scoring_policy"
        ],
        "properties": {
          "variety": {
            "type": [
              "string",
              "null"
            ]
          },
          "domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "audio": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference_conventions": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "reference_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "script": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z][a-z]{3}$"
          },
          "task": {
            "enum": [
              "transcription",
              "dialect_transcription",
              "standard_rendering",
              "translation",
              "non_speech"
            ]
          },
          "coverage_role": {
            "enum": [
              "primary",
              "optional"
            ],
            "description": "Coverage-planning role. Omitted in earlier v2 manifests; Swiss written-German rendering is primary and dialect spelling is optional. This field does not approve a case or prove coverage."
          },
          "split": {
            "enum": [
              "development",
              "held_out"
            ]
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "speaker_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_channel": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "enum": [
                  "mix",
                  null
                ]
              }
            ]
          },
          "code_switches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start_seconds",
                "end_seconds",
                "language"
              ],
              "properties": {
                "start_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "end_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "language": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "reviewed": {
            "type": "boolean"
          },
          "scoring_policy": {
            "enum": [
              "swift-nfc-casefold-alphanumeric-v1",
              "unicode-nfc-apostrophe-v2",
              "unicode-nfc-cer-v2",
              "arabic-nfc-strict-v2",
              "arabic-nfc-no-diacritics-v2"
            ]
          }
        }
      }
    }
  },
  "$comment": "Runtime validation additionally rejects duplicate IDs, invalid switch intervals, ambiguous Swiss task and development/held-out speaker/session/source/audio overlap. New Swiss coverage targets written Standard German through standard_rendering; dialect_transcription remains a separate optional task. coverage_role records planning only. Null preparation fields remain pending."
}
